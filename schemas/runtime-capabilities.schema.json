{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitt.local/schemas/runtime-capabilities.schema.json",
  "title": "KITT Runtime Capabilities, GPU Leases, Snapshots, Migration & Mount Contracts",
  "$defs": {
    "GpuVendor": { "type": "string", "enum": ["nvidia", "amd", "intel"] },
    "GpuIsolationMode": { "type": "string", "enum": ["exclusive", "vram_quota", "mig", "shared"] },
    "GpuLeaseState": { "type": "string", "enum": ["RESERVING", "ACTIVE", "RELEASING", "RELEASED", "INDETERMINATE"] },
    "MigrationMode": { "type": "string", "enum": ["cold", "warm", "live"] },
    "MigrationPhase": {
      "type": "string",
      "enum": [
        "VERIFY_TARGET", "RESERVE_RESOURCES", "QUIESCE_SOURCE", "SNAPSHOT",
        "TRANSFER", "VERIFY_INTEGRITY", "RESTORE", "HEALTH_CHECK",
        "SWAP_BINDING", "RELEASE_SOURCE", "ROLLED_BACK", "FAILED"
      ]
    },
    "MountKind": { "type": "string", "enum": ["github", "s3"] },
    "MountMaterializationState": { "type": "string", "enum": ["PENDING", "READY", "STALE", "ERROR", "REMOVED"] },
    "GpuDeviceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uuid", "vendor", "kfd_available", "mig_capable", "isolation_mode"],
      "properties": {
        "uuid": { "type": "string", "minLength": 1 },
        "vendor": { "$ref": "#/$defs/GpuVendor" },
        "pci_address": { "type": ["string", "null"] },
        "render_node": { "type": ["string", "null"] },
        "kfd_available": { "type": "boolean" },
        "total_vram_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "free_vram_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "shared_memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "mig_capable": { "type": "boolean" },
        "compute_backend": { "type": ["string", "null"] },
        "isolation_mode": { "$ref": "#/$defs/GpuIsolationMode" }
      }
    },
    "GpuLeaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "gpu_uuid", "owner_runtime_id", "worker_id", "mode", "state", "updated_at"],
      "properties": {
        "lease_id": { "type": "string", "minLength": 1 },
        "gpu_uuid": { "type": "string", "minLength": 1 },
        "owner_runtime_id": { "type": "string", "minLength": 1 },
        "worker_id": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/GpuIsolationMode" },
        "reserved_vram_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "state": { "$ref": "#/$defs/GpuLeaseState" },
        "updated_at": { "type": "integer" }
      }
    },
    "CompressionNegotiation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codecs", "max_compressed_bytes", "max_decompressed_bytes", "window_log_max", "adaptive_min_bytes"],
      "properties": {
        "codecs": { "type": "array", "items": { "type": "string" } },
        "max_compressed_bytes": { "type": "integer", "minimum": 1 },
        "max_decompressed_bytes": { "type": "integer", "minimum": 1 },
        "window_log_max": { "type": "integer", "minimum": 10, "maximum": 30 },
        "adaptive_min_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "MountSourceSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "alias", "mount_path", "read_only", "state", "digest"],
      "properties": {
        "kind": { "$ref": "#/$defs/MountKind" },
        "alias": { "type": "string", "minLength": 1 },
        "mount_path": { "type": "string", "minLength": 1 },
        "read_only": { "type": "boolean" },
        "state": { "$ref": "#/$defs/MountMaterializationState" },
        "digest": { "type": "string" },
        "repository": { "type": ["string", "null"] },
        "commit_sha": { "type": ["string", "null"] },
        "bucket": { "type": ["string", "null"] },
        "prefix": { "type": ["string", "null"] },
        "version_id": { "type": ["string", "null"] }
      }
    },
    "WorkerCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id", "name", "os", "arch", "version", "available", "state",
        "cpu_millis", "memory_bytes", "pids_limit", "gpus", "mount_aliases",
        "compression", "features", "executions", "failures", "last_heartbeat_at"
      ],
      "properties": {
        "worker_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "state": { "type": "string", "minLength": 1 },
        "cpu_millis": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "pids_limit": { "type": "integer", "minimum": 1 },
        "gpus": { "type": "array", "items": { "$ref": "#/$defs/GpuDeviceDescriptor" } },
        "mount_aliases": { "type": "array", "items": { "type": "string" } },
        "compression": { "$ref": "#/$defs/CompressionNegotiation" },
        "features": { "type": "array", "items": { "type": "string" } },
        "latency_ms": { "type": ["number", "null"] },
        "throughput_mbps": { "type": ["number", "null"] },
        "executions": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "last_heartbeat_at": { "type": "integer" }
      }
    },
    "SnapshotManifestV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "snapshot_id", "migration_mode", "image", "image_digest",
        "cpu_millis", "memory_bytes", "pids_limit", "gpu_count", "mount_aliases",
        "deleted_paths", "manifest_sha256", "created_at"
      ],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "snapshot_id": { "type": "string", "minLength": 1 },
        "parent_sha256": { "type": ["string", "null"] },
        "migration_mode": { "$ref": "#/$defs/MigrationMode" },
        "image": { "type": "string", "minLength": 1 },
        "image_digest": { "type": "string", "minLength": 1 },
        "cpu_millis": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "pids_limit": { "type": "integer", "minimum": 1 },
        "gpu_vendor": { "anyOf": [{ "$ref": "#/$defs/GpuVendor" }, { "type": "null" }] },
        "gpu_count": { "type": "integer", "minimum": 0 },
        "mount_aliases": { "type": "array", "items": { "type": "string" } },
        "deleted_paths": { "type": "array", "items": { "type": "string" } },
        "writable_layer_digest": { "type": ["string", "null"] },
        "manifest_sha256": { "type": "string", "minLength": 1 },
        "created_at": { "type": "integer" }
      }
    },
    "MigrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migration_id", "conversation_id", "source_worker_id", "target_worker_id", "mode", "phase", "compatible", "updated_at"],
      "properties": {
        "migration_id": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": "string", "minLength": 1 },
        "source_worker_id": { "type": "string", "minLength": 1 },
        "target_worker_id": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/MigrationMode" },
        "phase": { "$ref": "#/$defs/MigrationPhase" },
        "compatible": { "type": "boolean" },
        "snapshot_sha256": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] },
        "updated_at": { "type": "integer" }
      }
    },
    "BenchmarkReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "os", "arch", "version", "backend", "cpu", "ram", "gpu", "network", "runtime", "chunking"],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "version": { "type": "string" },
        "backend": { "type": "string" },
        "cpu": { "type": "object" },
        "ram": { "type": "object" },
        "gpu": { "type": "object" },
        "network": { "type": "object" },
        "runtime": { "type": "object" },
        "chunking": { "type": "object" }
      }
    }
  }
}
