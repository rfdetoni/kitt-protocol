{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitt.local/schemas/agent-contract-v3.schema.json",
  "title": "KITT Agent Contract v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "tool",
    "tool_input",
    "content",
    "reasoning_summary",
    "loop"
  ],
  "properties": {
    "action": {
      "enum": [
        "use_tool",
        "final_response",
        "request_workspace",
        "request_tools"
      ]
    },
    "tool": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_input": {
      "type": [
        "object",
        "null"
      ]
    },
    "content": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "reasoning_summary": {
      "type": "string",
      "maxLength": 400
    },
    "loop": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objective",
            "completion_criteria",
            "status",
            "validation_summary"
          ],
          "properties": {
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "completion_criteria": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "\\S"
              }
            },
            "status": {
              "enum": [
                "active",
                "checkpoint",
                "complete"
              ]
            },
            "validation_summary": {
              "type": "string",
              "maxLength": 600
            }
          }
        }
      ]
    }
  }
}
